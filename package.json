{
  "name": "mcp-palette",
  "version": "1.3.4",
  "description": "A palette for Model Context Protocol servers",
  "author": "cellwebb",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"cross-env VITE_DEV_SERVER_HOST=localhost VITE_DEV_SERVER_PORT=3000 vite --port 3000\" \"electron .\"",
    "minimal-build": "vite build && node minimal-build.js",
    "electron:preview": "vite build && electron .",
    "postinstall": "node chmod.js",
    "make-executable": "node chmod.js",
    "fix": "node chmod.js && ./fix-and-rebuild.sh",
    "fix-enter": "node chmod.js && ./fix-enter-key.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validator": "jest src/utils/validation/__tests__/mcpValidator.test.js",
    "test:components": "jest src/components",
    "test:validation": "jest src/components/validation",
    "electron:build": "electron-builder build --mac --x64 --dir"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "monaco-editor": "^0.44.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-monaco-editor": "^0.55.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.1",
    "cross-env": "^7.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^24.6.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^4.4.5",
    "wait-on": "^7.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cellwebb/mcp-palette.git"
  },
  "keywords": [
    "electron",
    "vite",
    "mcp",
    "palette",
    "llm",
    "ai",
    "desktop"
  ],
  "files": [
    "dist",
    "electron",
    "src",
    "main.js"
  ],
  "build": {
    "appId": "com.electron.mcp-palette",
    "productName": "MCP Palette",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dir"
    },
    "dir": "dist"
  }
}
